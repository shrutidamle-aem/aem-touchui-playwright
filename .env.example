# Copy the values you need into your shell. Nothing loads this file automatically.
# Unset values fall back to the defaults below: a stock local AEM SDK author with the
# bundled WKND example installed. Run /setup-project to get values for your own project.

# --- The author instance ---
# Author URL. Local SDK only: AEMaaCS author signs in through IMS, which the login step doesn't handle.
AEM_AUTHOR_URL=http://localhost:4502
# A user that can create and delete pages under AEM_SCRATCH_PARENT and edit what the specs touch.
AEM_USER=admin
AEM_PASSWORD=admin

# --- The project under test ---
# Page template each test's scratch page is created from. Its structure policy for the insert
# container must allow every component you insert, or that component never shows in the picker.
AEM_TEMPLATE=/conf/wknd/settings/wcm/templates/content-page-template
# Existing page the scratch pages are created under (as pw-<timestamp>, deleted after each test).
# Pick one nothing else depends on, and whose /conf allows AEM_TEMPLATE.
AEM_SCRATCH_PARENT=/content/wknd/us/en
# Path of the container components are inserted into, relative to the page, no leading slash.
# It must be an editable (unlocked) container in AEM_TEMPLATE's structure.
AEM_CONTAINER=jcr:content/root/container
