{
  "name": "aem-touchui-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright tests that drive the real AEM Touch UI page editor, for any AEM project that uses it.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=22" }
}
